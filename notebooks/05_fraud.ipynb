<cell id="fraud-cv"># ══════════════════════════════════════════════════════════════════════
#  1. VALIDATION CROISÉE — comparaison des variantes supervisées
# ══════════════════════════════════════════════════════════════════════
# SMOTE est intégré dans un imblearn Pipeline pour ne jamais
# échantillonner les folds de validation (pas de fuite de données).
from src.fraud.models import cross_validate_models

cv_results = cross_validate_models(train_fraud, n_folds=5, seed=123)
print(cv_results.to_string(index=False))</cell id="fraud-cv">
<cell id="fraud-boruta"># ══════════════════════════════════════════════════════════════════════
#  2. SÉLECTION DE FEATURES — Boruta (preuve méthodologique)
# ══════════════════════════════════════════════════════════════════════
# Boruta compare chaque feature à une "ombre" aléatoire pour distinguer
# les variables réellement discriminantes du bruit. Résultat informatif :
# on ne réduit PAS les features du modèle de production (compatibilité API).
from src.fraud.models import run_boruta_selection

boruta_res = run_boruta_selection(train_fraud, seed=123)
print(f"✅ Features confirmées ({len(boruta_res['confirmed'])}):")
for f in boruta_res["confirmed"]:
    print(f"   - {f}")
print(f"\n⚠️  Tentatives ({len(boruta_res['tentative'])}): {boruta_res['tentative']}")
print(f"❌ Rejetées ({len(boruta_res['rejected'])}):")
for f in boruta_res["rejected"]:
    print(f"   - {f}")</cell id="fraud-boruta">
<cell id="fraud-train"># ══════════════════════════════════════════════════════════════════════
#  3. ENTRAÎNEMENT — 7 approches de détection
# ══════════════════════════════════════════════════════════════════════
from src.fraud.models import (
    fit_supervised_baseline,      # Random Forest (référence)
    fit_xgboost,                  # XGBoost (scale_pos_weight)
    fit_svm,                      # SVM RBF
    fit_random_forest_smote,      # RF + SMOTE
    fit_xgboost_smote,            # XGB + SMOTE
    fit_isolation_forest,         # Isolation Forest (non supervisé)
    fit_local_outlier_factor,     # LOF (non supervisé)
)

models = {
    "Random Forest":     fit_supervised_baseline(train_fraud),
    "RF + SMOTE":        fit_random_forest_smote(train_fraud),
    "XGBoost":           fit_xgboost(train_fraud),
    "XGB + SMOTE":       fit_xgboost_smote(train_fraud),
    "SVM (RBF)":         fit_svm(train_fraud),
    "Isolation Forest":  fit_isolation_forest(train_fraud),
    "LOF":               fit_local_outlier_factor(train_fraud),
}
print("7 modèles entraînés.")</cell id="fraud-train">
<cell id="fraud-eval"># ══════════════════════════════════════════════════════════════════════
#  4. ÉVALUATION COMPARATIVE — métriques sur le jeu de test
# ══════════════════════════════════════════════════════════════════════
import pandas as pd
from src.fraud.models import (
    evaluate_classifier,
    evaluate_isolation_forest,
    evaluate_local_outlier_factor,
)

results = {}
for name, model in models.items():
    if name == "Isolation Forest":
        results[name] = evaluate_isolation_forest(model, test_fraud)
    elif name == "LOF":
        results[name] = evaluate_local_outlier_factor(model, test_fraud)
    else:
        results[name] = evaluate_classifier(model, test_fraud, model_name=name)

comparison = pd.DataFrame({
    name: {
        k: round(v, 4) for k, v in r.items()
        if k in ("auc_roc", "pr_auc", "precision", "recall", "f1")
    }
    for name, r in results.items()
}).T

print("=== Benchmark fraude — jeu de test ===")
print(comparison.sort_values("auc_roc", ascending=False))</cell id="fraud-eval">
<cell id="fraud-detail"># ── Rapport détaillé du meilleur modèle supervisé ─────────────────────
best_name = comparison[comparison["auc_roc"].notna()].sort_values("auc_roc", ascending=False).index[0]

print(f"🏆 Meilleur modèle (AUC-ROC) : {best_name}\n")
print("Matrice de confusion :")
print(pd.DataFrame(
    results[best_name]["confusion_matrix"],
    index=["Réel: non-fraude", "Réel: fraude"],
    columns=["Prédit: non-fraude", "Prédit: fraude"],
))
print(f"\nRapport de classification :\n{results[best_name]['classification_report']}")

print("Top 10 features (importance) :")
imp = results[best_name].get("feature_importance")
if imp:
    print(pd.Series(imp).sort_values(ascending=False).head(10))</cell id="fraud-detail">
<cell id="fraud-mlflow-log"># ══════════════════════════════════════════════════════════════════════
#  5. LOG MLFLOW — une run par variante (traçabilité MLOps)
# ══════════════════════════════════════════════════════════════════════
from src.common.tracking import log_run

for name, r in results.items():
    if "auc_roc" not in r:
        continue
    metrics = {k: r[k] for k in ("auc_roc", "pr_auc", "precision", "recall", "f1") if k in r}
    params = {"model": name, "features": 30, "smote": "SMOTE" in name, "seed": 123}
    log_run(
        f"fraud_{name.lower().replace(' ', '_')}",
        params,
        metrics,
        tags={"module": "fraud"},
    )
print(f"{len(results)} runs journalisées dans MLflow (fraud_benchmark).")</cell id="fraud-mlflow-log">
<cell id="fraud-save"># ══════════════════════════════════════════════════════════════════════
#  6. SAUVEGARDE — modèle de production + métadonnées (compatibilité API)
# ══════════════════════════════════════════════════════════════════════
import joblib
from pathlib import Path

Path("../models").mkdir(exist_ok=True)

# Encodeurs : mêmes catégories, même ordre que ceux vus par astype("category") à l'entraînement
from src.fraud.data import CATEGORICAL_COLS, NUMERIC_COLS

encoders = {col: df_fraud[col].astype("category").cat.categories.tolist() for col in CATEGORICAL_COLS}
joblib.dump(encoders, "../models/fraud_encoders.pkl")

# Statistiques de normalisation (moyenne, écart-type) par variable numérique
normalization_stats = {col: (df_fraud[col].mean(), df_fraud[col].std()) for col in NUMERIC_COLS}
joblib.dump(normalization_stats, "../models/fraud_normalization_stats.pkl")

# Valeurs par défaut = mode pour les catégorielles, médiane pour les numériques
default_values = {}
for col in CATEGORICAL_COLS:
    default_values[col] = train_fraud[col].mode()[0]
for col in NUMERIC_COLS:
    default_values[col] = train_fraud[col].median()
joblib.dump(default_values, "../models/fraud_default_values.pkl")

# Sauvegarder le meilleur modèle supervisé comme modèle de production
best_model = models[best_name]
joblib.dump(best_model, "../models/fraud_best_model.pkl")

# Toujours garder le Random Forest comme référence / fallback
joblib.dump(models["Random Forest"], "../models/fraud_random_forest.pkl")

print(f"🏆 Modèle de production : {best_name} → fraud_best_model.pkl")
print("Random Forest sauvegardé en fallback → fraud_random_forest.pkl")
print("4 fichiers de métadonnées mis à jour (encoders, normalisation, défauts).")</cell id="fraud-save">
<cell id="fraud-graph1"># ══════════════════════════════════════════════════════════════════════
#  ANNEXE — Tentatives par graphe (approche relationnelle, non retenue)
# ══════════════════════════════════════════════════════════════════════
# Les 4 stratégies de construction de graphe n'ont pas validé le test
# d'homophilie : les sinistres connectés ne partagent pas plus le label
# de fraude que des paires aléatoires. Le GNN a donc été écarté au profit
# des modèles supervisés (RF/XGBoost/SVM).
from src.fraud.graph import build_pyg_graph

feature_cols = [c for c in df_fraud.columns if c.endswith(("_code", "_norm")) and c not in ["RepNumber_code"]]
graph_data = build_pyg_graph(df_fraud, feature_cols, min_shared_attrs=2)

print("Nombre de nœuds :", graph_data.num_nodes)
print("Nombre d'arêtes (orientées, donc x2) :", graph_data.num_edges)
print("Degré moyen :", graph_data.num_edges / graph_data.num_nodes)

edge_index = graph_data.edge_index.numpy()
y = graph_data.y.numpy()
if graph_data.num_edges > 0:
    same_label = (y[edge_index[0]] == y[edge_index[1]]).mean()
    print(f"Proportion de paires connectées avec le même label : {same_label:.4f}")
    print(f"Référence (accord attendu au hasard) : {(y.mean()**2 + (1-y.mean())**2):.4f}")</cell id="fraud-graph1">
<cell id="fraud-graph2">
from src.fraud.graph import build_edge_index
similarity_cols = ["Fault", "AddressChange_Claim", "Days_Policy_Claim", "PolicyType", "BasePolicy"]

edge_index = build_edge_index(df_fraud, similarity_cols, min_shared_attrs=len(similarity_cols))

print("Nombre d'arêtes (orientées) :", edge_index.shape[1])
print("Degré moyen :", edge_index.shape[1] / len(df_fraud))

y = df_fraud["fraud_label"].values
if edge_index.shape[1] > 0:
    same_label = (y[edge_index[0].numpy()] == y[edge_index[1].numpy()]).mean()
    print(f"Proportion de paires connectées avec le même label : {same_label:.4f}")
    print(f"Référence hasard : {(y.mean()**2 + (1-y.mean())**2):.4f}")</cell id="fraud-graph2">
<cell id="fraud-graph3">
from src.fraud.graph import build_edge_index_rare_shared

cols_to_test = ["Fault", "AddressChange_Claim", "Days_Policy_Claim", "Days_Policy_Accident", "PastNumberOfClaims"]

edge_index = build_edge_index_rare_shared(df_fraud, cols_to_test, rarity_threshold=0.10)

print("Nombre d'arêtes (orientées) :", edge_index.shape[1])
print("Degré moyen :", edge_index.shape[1] / len(df_fraud))

y = df_fraud["fraud_label"].values
if edge_index.shape[1] > 0:
    same_label = (y[edge_index[0].numpy()] == y[edge_index[1].numpy()]).mean()
    print(f"Proportion de paires connectées avec le même label : {same_label:.4f}")
    print(f"Référence hasard : {(y.mean()**2 + (1-y.mean())**2):.4f}")

    for col in cols_to_test:
        freq = df_fraud[col].value_counts(normalize=True)
        rare_values = freq[freq < 0.10].index
        print(f"\n{col} — valeurs rares (< 10%) : {list(rare_values)}")</cell id="fraud-graph3">
<cell id="fraud-graph4"># Conclusion des tentatives par graphe.
print("Résultat : le test d'homophilie n'est pas validé (homophilie < référence hasard).")
print("→ Le GNN n'a pas été retenu : les modèles supervisés (RF/XGBoost/SVM) dominent.")</cell id="fraud-graph4">